# Server
PORT=5000
NODE_ENV=development

# MongoDB Atlas connection string (or mongodb://localhost:27017/cafe for local/docker)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/cafe?retryWrites=true&w=majority

# Comma-separated list of allowed frontend origins
CORS_ORIGIN=http://localhost:5173

# Admin auth (admin is created by `npm run seed`)
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=1d
ADMIN_EMAIL=admin@cafe.local
ADMIN_PASSWORD=change-me
