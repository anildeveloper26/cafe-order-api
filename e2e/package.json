{
  "name": "cafe-order-e2e",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "End-to-end tests (API + browser) for the cafe ordering app",
  "scripts": {
    "test": "playwright test",
    "test:api": "playwright test --project=api",
    "test:ui": "playwright test --project=ui",
    "test:headed": "playwright test --project=ui --headed",
    "report": "playwright show-report",
    "install:browsers": "playwright install chromium",
    "test:prod": "playwright test -c playwright.prod.config.ts",
    "test:prod:readonly": "E2E_READ_ONLY=1 playwright test -c playwright.prod.config.ts --grep-invert @write",
    "report:prod": "playwright show-report playwright-report-prod"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@types/node": "^26.6.6",
    "mongodb-memory-server": "^11.3.0",
    "typescript": "^7.0.2"
  }
}
